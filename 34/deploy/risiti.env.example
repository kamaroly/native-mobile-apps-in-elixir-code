# deploy/risiti.env.example: copy to /etc/risiti/risiti.env on the server,
# fill it in, and keep it there. Never commit the real one.
#
# One NAME=value per line, no quotes, comments on their own lines: systemd
# reads this file, and so does deploy.sh.

# Required. Generate both secrets with `mix phx.gen.secret`.
DATABASE_URL=ecto://risiti:CHANGE_ME@localhost/risiti
SECRET_KEY_BASE=CHANGE_ME
TOKEN_SIGNING_SECRET=CHANGE_ME
PHX_HOST=risiti.example.com

# Where receipt photos and attachments are kept.
EXPENSE_FILES_DIR=/var/lib/risiti/files

# Each service below is off until its lines are uncommented and filled in.

# Sign in with Google: the Web OAuth client id(s), comma-separated.
# GOOGLE_CLIENT_IDS=

# SMS codes, through Africa's Talking.
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# Android push, through Firebase. The key is the path to its JSON file.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_KEY=/etc/risiti/firebase-key.json

# iOS push, through APNs. The key file is the .p8 from Apple.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_KEY_FILE=/etc/risiti/apns-key.p8

# Email, through Mailtrap.
# MAILTRAP_API_KEY=
